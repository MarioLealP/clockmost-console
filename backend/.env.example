# backend config — env vars are prefixed CM_ (see app/config.py)
# copy to .env for local dev; on the server these come from the stack's sops secrets.env

CM_STATE_FILE=/data/state.json
CM_DATABASE_URL=sqlite+aiosqlite:////data/console.db
CM_DIST_DIR=dist
CM_POLL_SECONDS=20

# Home Assistant (phase 2) — leave empty to disable the HA routes
CM_HA_URL=
CM_HA_TOKEN=
